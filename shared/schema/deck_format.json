{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Threelanguage deck bundle (v1)",
  "description": "Формат колоды для сервера, клиента и импорта. ZIP: deck.json + media/. Совместим с импортом .apkg (конвертер build_decks.py).",
  "type": "object",
  "required": ["format_version", "lang", "level_scheme", "cards"],
  "properties": {
    "format_version": {"const": 1},
    "lang": {"type": "string", "description": "BCP-47 изучаемого языка"},
    "native_lang": {"type": "string"},
    "level_scheme": {"enum": ["CEFR", "HSK", "JLPT", "TOPIK", "NONE"]},
    "attribution": {"type": "string", "description": "CC-BY-SA Wiktionary/JMDict/..."},
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "senses"],
        "properties": {
          "text": {"type": "string"},
          "reading": {"type": ["string", "null"]},
          "senses": {"type": "array", "items": {"type": "object",
            "required": ["lang", "text"],
            "properties": {"lang": {"type": "string"}, "text": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}}}}},
          "examples": {"type": "array", "items": {"type": "object",
            "properties": {"target": {"type": "string"}, "gloss": {"type": "string"},
              "audio": {"type": "string", "description": "путь в ZIP media/"}}}},
          "script_tag": {"enum": ["lat", "cyrl", "hani", "hira", "kana", "hangul", null]},
          "level": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
          "diag_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "freq_rank": {"type": ["integer", "null"]}
        }
      }
    }
  }
}
